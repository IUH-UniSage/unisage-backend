
# ========== Ứng dụng ==========
SPRING_APPLICATION_NAME=Unisage_Assistant
SERVER_HOST=localhost
SERVER_PORT=8401
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========== Database ==========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=assistant_DB
DB_USER=postgres
DB_PASSWORD=123456

# ========== Account ==========
DEFAULT_SUPERADMIN_PASS=SuperAdmin@123

# ========== JWT ==========
JWT_ACCESS_TOKEN_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=2592000000
JWT_SECRET=Unisage_Enterprise_Assistant_Authentication_Secret_Key

# ========== Usage Limit ==========
USAGE_LIMIT_ENABLED=false
USER_DAILY_MESSAGE_LIMIT=30
GUEST_DAILY_MESSAGE_LIMIT=10
USAGE_LIMIT_TYPE=message
USAGE_LIMIT_SCOPE=daily

# ========== MinIO / Object Storage ==========
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=unisage-documents
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600
