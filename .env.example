
# ========== Ứng dụng ==========
SPRING_APPLICATION_NAME=Unisage_Assistant
SERVER_HOST=localhost
SERVER_PORT=8401
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========== Database ==========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=assistant_DB
DB_USER=postgres
DB_PASSWORD=123456

# ========== Account ==========
DEFAULT_SUPERADMIN_PASS=SuperAdmin@123
DEFAULT_INGESTADMIN_PASS=Ingest@123456
DEFAULT_USER_PASS=User@123456

# ========== JWT ==========
JWT_ACCESS_TOKEN_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=2592000000
JWT_SECRET=Unisage_Enterprise_Assistant_Authentication_Secret_Key

# ========== Encryption ==========
# Dùng để mã hoá apiKey của ChatModel (AES-256, key được băm SHA-256 từ chuỗi này).
APP_ENCRYPTION_KEY=Unisage_Enterprise_Assistant_ChatModel_ApiKey_Encryption_Key

# ========== Usage Limit (on/off is the system setting chat.usage_limit.enabled) ==========
# Zone used only to present reset times to users; counters are stored in UTC.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ========== MinIO / Object Storage ==========
MINIO_ENDPOINT=http://localhost:9000
# Host dùng để KÝ presigned URL — phải là host mà trình duyệt/client mở link được.
# Khi backend chạy trong Docker/devcontainer, MINIO_ENDPOINT trỏ tới hostname nội bộ
# (vd unisage-minio) không resolve được từ máy host, nên phải set biến này riêng
# (vd http://localhost:9000). Nếu bỏ trống, mặc định lấy theo MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=unisage-documents
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600
